# ============================================================================
# HOTELGEN — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copy this file to .env.local for local development.
# In production: enter these in Vercel Dashboard > Settings > Environment Variables.
#
# NEVER commit .env.local to git. (.gitignore already excludes it.)
# ============================================================================

# ----------------------------------------------------------------------------
# CENTRAL SUPABASE (ours — manages all hotels)
# ----------------------------------------------------------------------------
# Where to find:
#   1. Go to https://supabase.com/dashboard
#   2. Open your "hotelgen-central" project
#   3. Left sidebar > Project Settings > Data API
#   4. Copy "Project URL" and "API Keys"

CENTRAL_SUPABASE_URL=https://YOUR-CENTRAL-PROJECT-REF.supabase.co
CENTRAL_SUPABASE_ANON_KEY=eyJhbGciOi...
CENTRAL_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...


# ----------------------------------------------------------------------------
# DEMO HOTEL SUPABASE (first hotel for testing & sales demo)
# ----------------------------------------------------------------------------
# These will be encrypted and stored in bridge_credentials in Module 2.
# For Module 1, we use them directly for testing.

DEMO_HOTEL_SUPABASE_URL=https://YOUR-DEMO-HOTEL-REF.supabase.co
DEMO_HOTEL_SUPABASE_ANON_KEY=eyJhbGciOi...
DEMO_HOTEL_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...


# ----------------------------------------------------------------------------
# ENCRYPTION
# ----------------------------------------------------------------------------
# Used to encrypt bridge_credentials (Supabase keys for each hotel).
# Generate with: openssl rand -hex 32
# (Run this in your terminal, copy output, paste here.)
# Length: 64 hex characters = 256 bits = AES-256

ENCRYPTION_MASTER_KEY=GENERATE_WITH_OPENSSL_RAND_HEX_32


# ----------------------------------------------------------------------------
# ANTHROPIC (Claude — main AI for guest replies & departments)
# ----------------------------------------------------------------------------
# Where to find:
#   1. Go to https://console.anthropic.com/
#   2. Settings > API Keys > Create Key
#   3. Copy the key (shown only once!)

ANTHROPIC_API_KEY=sk-ant-api03-...


# ----------------------------------------------------------------------------
# OPENAI (Whisper voice transcription + embeddings for pgvector)
# ----------------------------------------------------------------------------
# Where to find:
#   1. https://platform.openai.com/api-keys
#   2. Create new secret key

OPENAI_API_KEY=sk-proj-...


# ----------------------------------------------------------------------------
# RESEND (Email service for emergency notifications & reports)
# ----------------------------------------------------------------------------
# Where to find:
#   1. https://resend.com/ — sign up (free tier: 3000 emails/month)
#   2. Verify your sending domain (or use onboarding@resend.dev for testing)
#   3. API Keys > Create

RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com


# ----------------------------------------------------------------------------
# TELEGRAM (per-hotel bots — Module 5 will add multi-bot support)
# ----------------------------------------------------------------------------
# For demo hotel only in Module 1.
# Where to get:
#   1. Open Telegram, search @BotFather
#   2. /newbot, follow prompts
#   3. Copy the HTTP API token

TELEGRAM_BOT_TOKEN_DEMO=123456789:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_BOT_USERNAME_DEMO=demo_resort_spa_bot
TELEGRAM_WEBHOOK_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_16


# ----------------------------------------------------------------------------
# MANYCHAT (WhatsApp + Instagram — multi-tenant)
# ----------------------------------------------------------------------------
# Used in Module 5. Each hotel will have its own ManyChat workspace.
# The webhook secret is shared, the workspace ID identifies the hotel.

MANYCHAT_WEBHOOK_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_16


# ----------------------------------------------------------------------------
# CRON JOBS (Vercel Cron)
# ----------------------------------------------------------------------------
# Vercel uses this to authenticate cron requests.
# Generate with: openssl rand -hex 32

CRON_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32


# ----------------------------------------------------------------------------
# APP CONFIG
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app
NODE_ENV=development


# ----------------------------------------------------------------------------
# ADMIN BOOTSTRAP (for first-time admin password setup in Module 2)
# ----------------------------------------------------------------------------
# Used ONCE to set initial passwords for master admins.
# Delete or rotate after first use.

DEFAULT_ADMIN_PASSWORD=AdminYonetici?=2026
ADMIN_BOOTSTRAP_TOKEN=GENERATE_WITH_OPENSSL_RAND_HEX_32

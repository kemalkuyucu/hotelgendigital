# ============================================================================
# HOTELGEN — .gitignore
# ============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
*.tsbuildinfo

# Production
/build

# Environment variables — NEVER commit!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Vercel
.vercel

# IDE & OS
.vscode/
.idea/
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
next-env.d.ts

# Local development
*.local
.local/

# Supabase local
**/supabase/.branches
**/supabase/.temp

# Backup files & secrets
**/credentials/
**/*-credentials.*
**/secrets/
*.key
*.pem
*.cert

# Logs
logs/
*.log
